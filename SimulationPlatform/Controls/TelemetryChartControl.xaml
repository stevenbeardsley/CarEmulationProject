<UserControl
    x:Class="SimulationPlatform.Controls.TelemetryChartControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SimulationPlatform.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="200"
    d:DesignWidth="400">

    <!--  Outer border gives each chart a clear outline against the grey page  -->
    <Border BorderBrush="{ThemeResource SystemControlForegroundBaseMediumBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Margin="6"
            Background="{ThemeResource SystemControlBackgroundAltHighBrush}">

        <Grid>
            <Grid.RowDefinitions>
                <!--  Header: title + live value  -->
                <RowDefinition Height="44"/>
                <!--  Chart canvas  -->
                <RowDefinition Height="*"/>
                <!--  Footer: axis labels  -->
                <RowDefinition Height="22"/>
            </Grid.RowDefinitions>

            <!--  Thin separator line under the header  -->
            <Border Grid.Row="0"
                    BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,0">
                <Grid VerticalAlignment="Center">

                    <!--  Title — larger, themed colour  -->
                    <TextBlock x:Name="TitleText"
                               Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <!--  Live value + unit — right-aligned, coloured by chart  -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="ValueText"
                                   FontSize="18"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="UnitText"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Bottom"
                                   Margin="3,0,0,2"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Drawing surface — inherits the card background  -->
            <Canvas x:Name="ChartCanvas"
                    Grid.Row="1"
                    Background="Transparent"
                    SizeChanged="ChartCanvas_SizeChanged"/>

            <!--  Footer: min / max / time label  -->
            <Border Grid.Row="2"
                    BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="10,0">
                <Grid VerticalAlignment="Center">
                    <TextBlock x:Name="MinText"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                               FontSize="9"/>
                    <TextBlock x:Name="MaxText"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                               FontSize="9"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="TIME →"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                               FontSize="9"
                               HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
