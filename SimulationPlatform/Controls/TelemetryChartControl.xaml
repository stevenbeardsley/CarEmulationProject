<UserControl
    x:Class="SimulationPlatform.Controls.TelemetryChartControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SimulationPlatform.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="200"
    d:DesignWidth="400">

    <Border Background="#111111" CornerRadius="6" Margin="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>

            <!--  Header: title left, live value right  -->
            <Grid Grid.Row="0" Padding="12,0">
                <TextBlock x:Name="TitleText"
                           Foreground="#888888"
                           FontSize="10"
                           FontWeight="SemiBold"
                           CharacterSpacing="80"
                           VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="ValueText"
                               FontSize="16"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="UnitText"
                               Foreground="#555555"
                               FontSize="10"
                               VerticalAlignment="Bottom"
                               Margin="3,0,0,2"/>
                </StackPanel>
            </Grid>

            <!--  Drawing surface  -->
            <Canvas x:Name="ChartCanvas"
                    Grid.Row="1"
                    Background="#080808"
                    SizeChanged="ChartCanvas_SizeChanged"/>

            <!--  Footer  -->
            <Grid Grid.Row="2" Padding="10,0">
                <TextBlock x:Name="MinText"
                           Foreground="#333333"
                           FontSize="8"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="MaxText"
                           Foreground="#333333"
                           FontSize="8"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                <TextBlock Text="TIME →"
                           Foreground="#333333"
                           FontSize="8"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
