<Page
    x:Class="SimulationPlatform.Pages.TelemetryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SimulationPlatform.Pages"
    xmlns:controls="using:SimulationPlatform.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#0D0D0D">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Toolbar ───────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2"
              Background="#0A0A0A"
              Padding="14,8">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="6">
                <Ellipse x:Name="StatusDot"
                         Width="8" Height="8"
                         Fill="#444444"/>
                <TextBlock x:Name="StatusText"
                           Text="Waiting for data…"
                           Foreground="#666666"
                           FontSize="11"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="LIVE TELEMETRY"
                       Foreground="#333333"
                       FontSize="10"
                       FontWeight="SemiBold"
                       CharacterSpacing="120"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <TextBlock x:Name="PacketCountText"
                       Foreground="#333333"
                       FontSize="10"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- ── Row 1: Speed | RPM ────────────────────────────────────────── -->
        <controls:TelemetryChartControl x:Name="SpeedChart"
                                        Grid.Row="1" Grid.Column="0"/>
        <controls:TelemetryChartControl x:Name="RpmChart"
                                        Grid.Row="1" Grid.Column="1"/>

        <!-- ── Row 2: Engine Temp | Fuel ─────────────────────────────────── -->
        <controls:TelemetryChartControl x:Name="TempChart"
                                        Grid.Row="2" Grid.Column="0"/>
        <controls:TelemetryChartControl x:Name="FuelChart"
                                        Grid.Row="2" Grid.Column="1"/>
    </Grid>
</Page>
