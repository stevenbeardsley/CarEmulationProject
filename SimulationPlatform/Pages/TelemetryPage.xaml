<Page
    x:Class="SimulationPlatform.Pages.TelemetryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SimulationPlatform.Pages"
    xmlns:controls="using:SimulationPlatform.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

	<!--  No Background set here — inherits the default WinUI 3 system grey
          (ApplicationPageBackgroundThemeBrush) so the window looks native.  -->

	<Grid Padding="8">
		<Grid.RowDefinitions>
			<!--  Toolbar  -->
			<RowDefinition Height="Auto"/>
			<!--  Top row of charts  -->
			<RowDefinition Height="*"/>
			<!--  Bottom row of charts  -->
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- ── Toolbar ───────────────────────────────────────────────────── -->
		<Border Grid.Row="0" Grid.ColumnSpan="2"
                BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="14,8"
                Margin="6,6,6,4">

			<Grid>
				<StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="6">
					<Ellipse x:Name="StatusDot"
                             Width="9" Height="9"
                             Fill="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
					<TextBlock x:Name="StatusText"
                               Text="Waiting for data…"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"/>
				</StackPanel>

				<TextBlock Text="NEON Live Telemetry"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           CharacterSpacing="100"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

				<TextBlock x:Name="PacketCountText"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                           FontSize="11"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
			</Grid>
		</Border>

		<!-- ── Row 1: Speed | RPM ────────────────────────────────────────── -->
		<controls:TelemetryChartControl x:Name="SpeedChart"
                                        Grid.Row="1" Grid.Column="0"/>
		<controls:TelemetryChartControl x:Name="RpmChart"
                                        Grid.Row="1" Grid.Column="1"/>

		<!-- ── Row 2: Engine Temp | Fuel ─────────────────────────────────── -->
		<controls:TelemetryChartControl x:Name="TempChart"
                                        Grid.Row="2" Grid.Column="0"/>
		<controls:TelemetryChartControl x:Name="FuelChart"
                                        Grid.Row="2" Grid.Column="1"/>
	</Grid>
</Page>
