<Page
    x:Class="SimulationPlatform.Pages.DeployPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SimulationPlatform.Pages">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Config area grows/shrinks -->
            <RowDefinition Height="*"/>
            <!-- Deploy/status -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="20,16,20,0" Spacing="4">
            <TextBlock Text="Deploy Page"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       FontSize="32"/>
            <TextBlock Text="Configure and deploy a vehicle for the track."
                       FontSize="14"
                       Foreground="DarkGray"/>
        </StackPanel>

        <!-- MAIN CONTENT: scrolls if window is small -->
        <ScrollViewer Grid.Row="1"
                      Margin="20,12,20,0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      IsScrollInertiaEnabled="True">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border CornerRadius="16"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Padding="16"
                        HorizontalAlignment="Center"
                        MaxWidth="1100">

                    <Viewbox Stretch="Uniform"
                             StretchDirection="Both"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Top">

                        <Grid Width="1100" Height="520">
                            <!-- Car image -->
                            <Image Source="/Assets/carBackground.png"
                                   Stretch="Fill"
                                   Opacity="0.6"
                                   Width="1100"
                                   Height="520"/>

                            <ComboBox x:Name="ColourComboBox"
                                      Width="180"
                                      PlaceholderText="Colour"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top"
                                      Margin="10,100,0,0"
                                      IsEnabled="{x:Bind m_selectionEnabled, Mode=OneWay}"
                                      SelectionChanged="ColourComboBox_SelectionChanged">
                                <ComboBoxItem Content="Blue"/>
                                <ComboBoxItem Content="Red"/>
                                <ComboBoxItem Content="Green"/>
                            </ComboBox>

                            <ComboBox Width="180"
                                      PlaceholderText="Engine Type"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top"
                                      Margin="10,460,0,0"
                                      IsEnabled="{x:Bind m_selectionEnabled, Mode=OneWay}"
                                      SelectionChanged="EngineComboBox_SelectionChanged">
                                <ComboBoxItem Content="1.0L"/>
                                <ComboBoxItem Content="2.0L"/>
                            </ComboBox>

                            <ComboBox Width="180"
                                      PlaceholderText="Transmission"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top"
                                      Margin="780,460,0,0"
                                      IsEnabled="{x:Bind m_selectionEnabled, Mode=OneWay}"
                                      SelectionChanged="TransmissionComboBox_SelectionChanged">
                                <ComboBoxItem Content="5-speed"/>
                                <ComboBoxItem Content="7-speed"/>
                            </ComboBox>
                        </Grid>
                    </Viewbox>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- DEPLOY / STATUS -->
        <StackPanel Grid.Row="2" Margin="20,16,20,30" Spacing="8" VerticalAlignment="Top">
            <TextBlock Text="Select a valid configuration for the car."
                       Foreground="DarkGray"
                       FontSize="14"
                       Margin="0,0,0,5"
                       Visibility="{x:Bind m_selectOptionTextVisibility, Mode=OneWay}"/>

            <StackPanel Orientation="Horizontal" Spacing="16">
                <Button Click="DeployButton_Click"
                        IsEnabled="{x:Bind m_deployButtonEnabled, Mode=OneWay}"
                        HorizontalAlignment="Left"
                        BorderBrush="#4CAF50"
                        BorderThickness="1"
                        Background="White"
                        Foreground="#4CAF50"
                        CornerRadius="12"
                        Padding="18,12"
                        MinHeight="44">

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <SymbolIcon Symbol="Play" Width="18" Height="18"/>
                        <TextBlock Text="Deploy"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <Button Click="UndeployButton_Click"
                        HorizontalAlignment="Left"
                        IsEnabled="{x:Bind m_undeployButtonEnabled, Mode=OneWay}"
                        BorderBrush="#E53935"
                        BorderThickness="1"
                        Background="White"
                        Foreground="#E53935"
                        CornerRadius="12"
                        Padding="18,12"
                        MinHeight="44">

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <SymbolIcon Symbol="Stop" Width="18" Height="18"/>
                        <TextBlock Text="Undeploy"
                               VerticalAlignment="Center"
                               FontSize="15"
                               FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock Text="Deploying..." FontSize="14" Foreground="Orange"
                       Visibility="{x:Bind DeployingVisibility, Mode=OneWay}"/>
            <TextBlock Text="Successfully deployed" FontSize="14" Foreground="Green"
                       Visibility="{x:Bind ConnectedVisibility, Mode=OneWay}"/>
            <TextBlock Text="Deployment failed" FontSize="14" Foreground="IndianRed"
                       Visibility="{x:Bind DeployErrorVisibility, Mode=OneWay}"/>
        </StackPanel>
    </Grid>
</Page>
