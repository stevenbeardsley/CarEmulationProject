<Page
    x:Class="SimulationPlatform.Pages.TrackPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SimulationPlatform.Pages">
    <Page.Resources>
        <Storyboard x:Name="LaneScrollStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation
            x:Name="LaneScrollAnim"
            Storyboard.TargetName="LaneMarkersTransform"
            Storyboard.TargetProperty="Y"
            From="0"
            To="0"
            Duration="0:0:1" />
        </Storyboard>
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="20,0,0,0">
            <TextBlock Text="Track Page"
                       FontSize="32"
                       HorizontalAlignment="Left"/>
            <TextBlock Text="Control a virtual vehicle on a simulated track."
                       FontSize="14"
                       Foreground="DarkGray"/>
        </StackPanel>

        <!-- Left column: track view + controls -->
        <Grid Grid.Row="1" Grid.Column="0" Margin="20,10,20,20" MaxHeight="700">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Track / Map area -->
            <Border Grid.Row="0"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                    Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                    Padding="16">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Simple 2D road "map" placeholder -->
                    <Grid Grid.Column="0">
                        <Border CornerRadius="12"
                                Background="{ThemeResource SystemControlBackgroundAltMediumBrush}"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}">
                            <Grid>
                                <!-- "Road" -->
                                <Border Margin="40"
        CornerRadius="18"
        Background="#FF2B2B2B">

                                    <!-- Viewport (we clip this in code via LaneViewport.Clip) -->
                                    <Grid x:Name="LaneViewport">

                                        <!-- This container moves. It holds TWO identical copies -->
                                        <Grid x:Name="LaneScrollContent" VerticalAlignment="Top">
                                            <Grid.RenderTransform>
                                                <TranslateTransform x:Name="LaneMarkersTransform" Y="0"/>
                                            </Grid.RenderTransform>

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Copy A -->
                                            <StackPanel Grid.Row="0"
                        Orientation="Vertical"
                        HorizontalAlignment="Center"
                        Spacing="14">
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                            </StackPanel>

                                            <!-- Copy B (identical) -->
                                            <StackPanel Grid.Row="1"
                        Orientation="Vertical"
                        HorizontalAlignment="Center"
                        Spacing="14">
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Top-down car placeholder TODO: Make colour configurable -->
                                <!-- Top-down car placeholder (improved) -->
                                <Grid Width="60"
      Height="110"
      HorizontalAlignment="Center"
      VerticalAlignment="Center">

                                    <!-- Shadow -->
                                    <Border Width="52"
            Height="100"
            CornerRadius="14"
            Background="#33000000"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="2,4,0,0"/>

                                    <!-- Car body -->
                                    <Border Width="52"
            Height="100"
            CornerRadius="14"
            Background="#FF3A86FF"
            BorderThickness="1"
            BorderBrush="#AAFFFFFF"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

                                        <Grid>

                                            <!-- Wheels -->
                                            <Rectangle Width="8" Height="20"
                       Fill="#FF1E1E1E"
                       RadiusX="3" RadiusY="3"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Margin="-4,14,0,0"/>
                                            <Rectangle Width="8" Height="20"
                       Fill="#FF1E1E1E"
                       RadiusX="3" RadiusY="3"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Margin="0,14,-4,0"/>

                                            <Rectangle Width="8" Height="20"
                       Fill="#FF1E1E1E"
                       RadiusX="3" RadiusY="3"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Margin="-4,0,0,14"/>
                                            <Rectangle Width="8" Height="20"
                       Fill="#FF1E1E1E"
                       RadiusX="3" RadiusY="3"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="0,0,-4,14"/>

                                            <!-- Cabin -->
                                            <Border Width="36"
                    Height="44"
                    CornerRadius="10"
                    Background="#FF2F6FD6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,-6,0,0"/>

                                            <!-- Windscreen -->
                                            <Rectangle Width="26"
                       Height="12"
                       Fill="#66FFFFFF"
                       RadiusX="4" RadiusY="4"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,18,0,0"/>

                                            <!-- Rear window -->
                                            <Rectangle Width="22"
                       Height="10"
                       Fill="#44FFFFFF"
                       RadiusX="4" RadiusY="4"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,20"/>

                                            <!-- Hood detail -->
                                            <Rectangle Width="6"
                       Height="18"
                       Fill="#33FFFFFF"
                       RadiusX="3" RadiusY="3"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,6,0,0"/>

                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <TextBlock Text="Track View"
                                   Margin="10"
                                   Foreground="DarkGray"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Right-side controls within the track panel -->
                    <StackPanel Grid.Column="1"
                                Margin="16,0,0,0"
                                Width="180"
                                Spacing="14">

                        <!-- Acceleration slider -->
                        <Border CornerRadius="12"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                                Background="{ThemeResource SystemControlBackgroundAltMediumBrush}"
                                Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Acceleration"
                                           FontWeight="SemiBold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                <TextBlock Text="100%"
                                           Foreground="DarkGray"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Top"/>

                                    <TextBlock Grid.Column="0"
                                               Text="0%"
                                               Foreground="DarkGray"
                                               VerticalAlignment="Bottom"
                                               Margin="0,0,10,0"/>
                                    <Slider x:Name="AccelerationSlider"
                                        Grid.Column="1"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="{x:Bind Acceleration, Mode=TwoWay}"
                                        ValueChanged="AccelerationSlider_ValueChanged"
                                        Orientation="Vertical"
                                        Height="220"
                                        VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Gear controls -->
                        <Border CornerRadius="12"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                                Background="{ThemeResource SystemControlBackgroundAltMediumBrush}"
                                Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Transmission"
                                           FontWeight="SemiBold"/>

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Content="Gear -"
                                            HorizontalAlignment="Stretch"
                                            Click="GearShiftDown_Click"
                                            IsEnabled="{x:Bind m_downShiftEnabled, Mode= OneWay }"/>
                                    
                                    <Button Grid.Column="1"
                                            Content="Gear +"
                                            HorizontalAlignment="Stretch"
                                            Click="GearShiftUp_Click"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <TextBlock Text="Current:"
                                               Foreground="DarkGray"/>
                                    <TextBlock Text="{x:Bind Gear, Mode=OneWay}"
                                               FontSize="20"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Extra placeholder buttons -->
                        <Border CornerRadius="12"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                                Background="{ThemeResource SystemControlBackgroundAltMediumBrush}"
                                Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Controls"
                                           FontWeight="SemiBold"/>
                                <Button Content="Start / Stop"/>
                                <Button Content="Reset Position"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Bottom hint/status bar -->
            <Border Grid.Row="1"
                    Margin="0,12,0,0"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                    Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                    Padding="12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Status:"
                               Foreground="DarkGray"/>
                    <TextBlock Text="Idle"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="•"
                               Foreground="DarkGray"/>
                    <TextBlock Text="Use the slider and gear buttons (no logic yet)."
                               Foreground="DarkGray"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Right column: dashboard -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="0,20,20,20">
            <Border CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                    Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                    Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="Dashboard"
                               FontSize="20"
                               FontWeight="SemiBold"/>

                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Speed -->
                        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                CornerRadius="12"
                                Background="{ThemeResource SystemControlBackgroundAltMediumBrush}"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                                Padding="14">
                            <StackPanel>
                                <TextBlock Text="SPEED" Foreground="DarkGray" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                                    <TextBlock Text="{x:Bind Speed, Mode=OneWay}" FontSize="56" FontWeight="Bold"/>
                                    <TextBlock Text="mph" FontSize="22" Foreground="DarkGray" Margin="0,0,0,8"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- RPM -->
                        <Border Grid.Row="1" Grid.Column="0"
                                CornerRadius="12"
                                Background="{ThemeResource SystemControlBackgroundAltMediumBrush}"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                                Padding="14">
                            <StackPanel>
                                <TextBlock Text="RPM" Foreground="DarkGray" FontWeight="SemiBold"/>
                                <TextBlock Text="3,450" FontSize="34" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <!-- Gear -->
                        <Border Grid.Row="1" Grid.Column="1"
                                CornerRadius="12"
                                Background="{ThemeResource SystemControlBackgroundAltMediumBrush}"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                                Padding="14">
                            <StackPanel>
                                <TextBlock Text="GEAR" Foreground="DarkGray" FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind Gear, Mode=OneWay}" FontSize="34" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <!-- Throttle -->
                        <Border Grid.Row="2" Grid.Column="0"
                                CornerRadius="12"
                                Background="{ThemeResource SystemControlBackgroundAltMediumBrush}"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                                Padding="14">
                            <StackPanel>
                                <TextBlock Text="THROTTLE" Foreground="DarkGray" FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind AccelerationText, Mode=OneWay}"
                                   FontSize="28"
                                   FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <!-- Temp -->
                        <Border Grid.Row="2" Grid.Column="1"
                                CornerRadius="12"
                                Background="{ThemeResource SystemControlBackgroundAltMediumBrush}"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                                Padding="14">
                            <StackPanel>
                                <TextBlock Text="TEMP" Foreground="DarkGray" FontWeight="SemiBold"/>
                                <TextBlock Text="92*C" FontSize="28" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <!-- Notes / alerts -->
                        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                CornerRadius="12"
                                Background="{ThemeResource SystemControlBackgroundAltMediumBrush}"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                                Padding="14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="INFO" Foreground="DarkGray" FontWeight="SemiBold"/>
                                <TextBlock Text="Data is received from the Networked ECU Orchestration Nodes (NEON)."
                                           TextWrapping="Wrap"
                                           Foreground="DarkGray"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
