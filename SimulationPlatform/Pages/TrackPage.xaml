<Page
    x:Class="SimulationPlatform.Pages.TrackPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SimulationPlatform.Pages">

    <Page.Resources>
        <Storyboard x:Name="LaneScrollStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation
                x:Name="LaneScrollAnim"
                Storyboard.TargetName="LaneMarkersTransform"
                Storyboard.TargetProperty="Y"
                From="0"
                To="0"
                Duration="0:0:1" />
        </Storyboard>
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Margin="20,0,0,0">
            <TextBlock Text="Track Page"
                       FontSize="32"
                       HorizontalAlignment="Left"/>
            <TextBlock Text="Control a virtual vehicle on a simulated track."
                       FontSize="14"
                       Foreground="DarkGray"/>
        </StackPanel>

        <Grid Grid.Row="1" Grid.Column="0" Margin="20,10,20,20" MaxHeight="700">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                    Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                    Padding="16">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Border CornerRadius="12"
                                Background="{ThemeResource SystemControlBackgroundAltMediumBrush}"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}">
                            <Grid>
                                <Border Margin="40"
                                        CornerRadius="18"
                                        Background="#FF2B2B2B">

                                    <Grid x:Name="LaneViewport">

                                        <Grid x:Name="LaneScrollContent" VerticalAlignment="Top">
                                            <Grid.RenderTransform>
                                                <TranslateTransform x:Name="LaneMarkersTransform" Y="0"/>
                                            </Grid.RenderTransform>

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0"
                                                        Orientation="Vertical"
                                                        HorizontalAlignment="Center"
                                                        Spacing="14">
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1"
                                                        Orientation="Vertical"
                                                        HorizontalAlignment="Center"
                                                        Spacing="14"
                                                        Margin="0,14,0,0">
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                                <Rectangle Width="6" Height="28" Fill="#66FFFFFF" RadiusX="2" RadiusY="2"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Grid Width="60"
                                      Height="110"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center">

                                    <Border Width="52"
                                            Height="100"
                                            CornerRadius="14"
                                            Background="#33000000"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="2,4,0,0"/>

                                    <Border Width="52"
                                            Height="100"
                                            CornerRadius="14"
                                            Background="{x:Bind m_colour, Mode=OneWay}"
                                            BorderThickness="1"
                                            BorderBrush="#AAFFFFFF"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">

                                        <Grid>
                                            <Rectangle Width="8" Height="20"
                                                       Fill="#FF1E1E1E"
                                                       RadiusX="3" RadiusY="3"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Top"
                                                       Margin="-4,14,0,0"/>
                                            <Rectangle Width="8" Height="20"
                                                       Fill="#FF1E1E1E"
                                                       RadiusX="3" RadiusY="3"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Top"
                                                       Margin="0,14,-4,0"/>

                                            <Rectangle Width="8" Height="20"
                                                       Fill="#FF1E1E1E"
                                                       RadiusX="3" RadiusY="3"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Bottom"
                                                       Margin="-4,0,0,14"/>
                                            <Rectangle Width="8" Height="20"
                                                       Fill="#FF1E1E1E"
                                                       RadiusX="3" RadiusY="3"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Bottom"
                                                       Margin="0,0,-4,14"/>

                                            <Border Width="36"
                                                    Height="44"
                                                    CornerRadius="10"
                                                    Background="{x:Bind m_colour, Mode=OneWay}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Margin="0,-6,0,0"/>

                                            <Rectangle Width="26"
                                                       Height="12"
                                                       Fill="#66FFFFFF"
                                                       RadiusX="4" RadiusY="4"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Top"
                                                       Margin="0,18,0,0"/>

                                            <Rectangle Width="22"
                                                       Height="10"
                                                       Fill="#44FFFFFF"
                                                       RadiusX="4" RadiusY="4"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Bottom"
                                                       Margin="0,0,0,20"/>

                                            <Rectangle Width="6"
                                                       Height="18"
                                                       Fill="#33FFFFFF"
                                                       RadiusX="3" RadiusY="3"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Top"
                                                       Margin="0,6,0,0"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <TextBlock Text="Track View"
                                   Margin="10"
                                   Foreground="DarkGray"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"/>
                    </Grid>

                    <StackPanel Grid.Column="1"
                                Margin="16,0,0,0"
                                Width="180"
                                Spacing="14">

                        <Border CornerRadius="12"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                                Background="{ThemeResource SystemControlBackgroundAltMediumBrush}"
                                Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Pedals"
                                           FontWeight="SemiBold"/>

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="5" HorizontalAlignment="Center">
                                        <TextBlock Text="Throttle" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="12" 
                                                   Foreground="DarkGray"
                                                   HorizontalAlignment="Center"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="100%" Foreground="DarkGray" FontSize="10" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                            <TextBlock Grid.Column="0" Text="0%" Foreground="DarkGray" FontSize="10" VerticalAlignment="Bottom" Margin="0,0,5,0"/>

                                            <Slider x:Name="AccelerationSlider"
                                                    Grid.Column="1"
                                                    Minimum="0" Maximum="100"
                                                    Value="{x:Bind Acceleration, Mode=TwoWay}"
                                                    ValueChanged="AccelerationSlider_ValueChanged"
                                                    PointerReleased="AccelerationSlider_PointerReleased"
                                                    PointerCaptureLost="AccelerationSlider_PointerCaptureLost"
                                                    Orientation="Vertical"
                                                    Height="200"
                                                    VerticalAlignment="Center"/>
                                        </Grid>

                                        <TextBlock Text="{x:Bind AccelerationText, Mode=OneWay}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="5" HorizontalAlignment="Center">
                                        <TextBlock Text="Brake" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="12" 
                                                   Foreground="DarkGray"
                                                   HorizontalAlignment="Center"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="100%" Foreground="DarkGray" FontSize="10" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                            <TextBlock Grid.Column="0" Text="0%" Foreground="DarkGray" FontSize="10" VerticalAlignment="Bottom" Margin="0,0,5,0"/>

                                            <Slider x:Name="BrakeSlider"
                                                    Grid.Column="1"
                                                    Minimum="0" Maximum="100"
                                                    Value="{x:Bind Brake, Mode=TwoWay}"
                                                    ValueChanged="BrakeSlider_ValueChanged"
                                                    PointerReleased="BrakeSlider_PointerReleased"
                                                    PointerCaptureLost="BrakeSlider_PointerCaptureLost"
                                                    Orientation="Vertical"
                                                    Height="200"
                                                    VerticalAlignment="Center"/>
                                        </Grid>

                                        <TextBlock Text="{x:Bind BrakeText, Mode=OneWay}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="12"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                                Background="{ThemeResource SystemControlBackgroundAltMediumBrush}"
                                Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Transmission"
                                           FontWeight="SemiBold"/>

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Content="Gear -"
                                            HorizontalAlignment="Stretch"
                                            Click="GearShiftDown_Click"
                                            IsEnabled="{x:Bind m_downShiftEnabled, Mode=OneWay}"/>

                                    <Button Grid.Column="1"
                                            Content="Gear +"
                                            HorizontalAlignment="Stretch"
                                            Click="GearShiftUp_Click"
                                            IsEnabled="{x:Bind m_upShiftEnabled, Mode=OneWay}"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <TextBlock Text="Current gear:"
                                               Foreground="DarkGray"
                                               HorizontalAlignment="Left"/>
                                    <TextBlock Text="{x:Bind Gear, Mode=OneWay}"
                                               FontSize="20"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="12"
                                Background="{ThemeResource SystemControlBackgroundAltMediumBrush}"
                                BorderThickness="1"
                                Height="80"
                                BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                                Padding="14">
                            <StackPanel>
                                <TextBlock Text="Engine Temperature"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind EngineTemp, Mode=OneWay}"
                                           FontSize="28" 
                                           FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="0,12,0,0"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                    Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                    Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button x:Name="RefuelBtn" Content="Refuel" Click="Refuel_Click" Width="100"/>
                        <Button x:Name="RedeployBtn" Content="Redeploy" Click="Redeploy_Click" Width="100"/>
                        <Button x:Name="IgnitionBtn" Content="Ignition" Click="Ignition_Click" Width="100"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="0,20,20,20">
            <Border CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                    Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                    Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="Dashboard"
                               FontSize="20"
                               FontWeight="SemiBold"/>

                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                CornerRadius="12"
                                Background="{ThemeResource SystemControlBackgroundAltMediumBrush}"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                                Padding="14">
                            <StackPanel>
                                <TextBlock Text="SPEED" Foreground="DarkGray" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                                    <TextBlock Text="{x:Bind Speed, Mode=OneWay}" FontSize="56" FontWeight="Bold"/>
                                    <TextBlock Text="mph" FontSize="22" Foreground="DarkGray" Margin="0,0,0,8"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                Height="160"
                                CornerRadius="12"
                                Background="{ThemeResource SystemControlBackgroundAltMediumBrush}"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                                Padding="14">
                            <StackPanel Spacing="5">
                                <TextBlock Text="RPM" Foreground="DarkGray" FontWeight="SemiBold"/>

                                <Grid Width="190" Height="155" HorizontalAlignment="Center">
                                    <Path x:Name="RpmTrackPath"
                                      StrokeThickness="12"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stroke="{ThemeResource SystemControlForegroundBaseLowBrush}"/>

                                    <Path x:Name="RpmRedlinePath"
                                      StrokeThickness="12"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stroke="OrangeRed"/>

                                    <Grid Width="190" Height="155">
                                        <Grid.RenderTransform>
                                            <RotateTransform x:Name="RpmNeedleRotate"
                                                     Angle="0"
                                                     CenterX="95"
                                                     CenterY="78"/>
                                        </Grid.RenderTransform>

                                        <Line X1="95" Y1="78" X2="25" Y2="78"
                                              Stroke="White"
                                              StrokeThickness="3"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"/>

                                        <Ellipse Width="12" Height="12"
                                                     Fill="White"
                                                     HorizontalAlignment="Left"
                                                     VerticalAlignment="Top"
                                                     Margin="89,72,0,0"/>
                                    </Grid>

                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="0" Margin="0,0,0,0">
                                        <TextBlock Text="{x:Bind Rpm, Mode=OneWay}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                        <TextBlock Text="rpm"
                                           Foreground="DarkGray"
                                           FontSize="12"
                                           HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                            Height="160"
                            CornerRadius="12"
                            Background="{ThemeResource SystemControlBackgroundAltMediumBrush}"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                            Padding="14">
                            <StackPanel Spacing="5">
                                <TextBlock Text="FUEL" Foreground="DarkGray" FontWeight="SemiBold"/>

                                <Grid Width="190" Height="155" HorizontalAlignment="Center">
                                    <Path x:Name="FuelTrackPath"
                                      StrokeThickness="12"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stroke="{ThemeResource SystemControlForegroundBaseLowBrush}"/>

                                    <Path x:Name="FuelLowPath"
                                      StrokeThickness="12"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stroke="OrangeRed"/>

                                    <Grid Width="190" Height="155">
                                        <Grid.RenderTransform>
                                            <RotateTransform x:Name="FuelNeedleRotate"
                                                 Angle="0"
                                                 CenterX="95"
                                                 CenterY="78"/>
                                        </Grid.RenderTransform>

                                        <Line X1="95" Y1="78" X2="25" Y2="78"
                                              Stroke="White"
                                              StrokeThickness="3"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"/>

                                        <Ellipse Width="12" Height="12"
                                             Fill="White"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Top"
                                             Margin="89,72,0,0"/>
                                    </Grid>

                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="0">
                                        <TextBlock Text="{x:Bind FuelPercentageText, Mode=OneWay}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="4"
                            Grid.ColumnSpan="2"
                            CornerRadius="12"
                            Background="{ThemeResource SystemControlBackgroundAltMediumBrush}" 
                            BorderThickness="1" 
                            BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                            Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="WARNINGS &amp; ALERTS" 
                                   Foreground="DarkGray" 
                                   FontWeight="Bold" 
                                   FontSize="12" 
                                   Margin="0,0,0,8"/>

                                <ListView Grid.Row="1" 
                                      ItemsSource="{x:Bind ActiveErrors, Mode=OneWay}"
                                      SelectionMode="None"
                                      HorizontalAlignment="Stretch">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:ErrorViewModel">
                                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4">
                                                <SymbolIcon Symbol="{x:Bind Icon, Mode=OneWay}" 
                                                    Foreground="OrangeRed" 
                                                    Width="20"/>
                                                <StackPanel Orientation="Vertical">
                                                    <TextBlock Text="{x:Bind Message}" 
                                                       VerticalAlignment="Center"
                                                       FontSize="14"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>

                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="MinHeight" Value="40"/>
                                            <Setter Property="Padding" Value="4,0"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>